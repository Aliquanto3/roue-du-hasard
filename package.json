{
  "name": "roue-du-hasard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harnais": "vite --config tests/harnais/vite.config.ts",
    "build:harnais": "vite build --config tests/harnais/vite.config.ts",
    "test:e2e": "npm run build && npm run build:harnais && playwright test",
    "test:e2e:chromium": "npm run test:e2e -- --project=chromium",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
